# Copy to infra/.env (ignored by git) and fill in local-only values. Never commit real secrets.

# PostgreSQL superusers (only used by the init scripts and for maintenance)
POSTGRES_MAIN_SUPERUSER_PASSWORD=
POSTGRES_BALLOT_SUPERUSER_PASSWORD=

# Service database roles (usernames are fixed: identity, election, voter_access, ballot_box, keycloak)
IDENTITY_DB_PASSWORD=
ELECTION_DB_PASSWORD=
VOTER_ACCESS_DB_PASSWORD=
BALLOT_BOX_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap administrator (local only)
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
